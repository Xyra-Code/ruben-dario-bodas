# Cabeceras de Cloudflare Workers (static assets). Se aplican al publicar ./out.

# Seguridad básica en todo el sitio.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# JS, CSS y fuentes de Next llevan hash en el nombre: un año en caché.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos y marca no llevan hash: una semana, y se revalidan en segundo plano.
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/marca/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
